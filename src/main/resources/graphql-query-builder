🧩 2. Esqueleto da lib:
public class GraphQLQuery {

    private final String root;
    private final SelectionNode selection;
    private final Map<String, Object> args;

    public GraphQLQuery(String root, SelectionNode selection, Map<String, Object> args) {
        this.root = root;
        this.selection = selection;
        this.args = args;
    }

    public String render() {
        StringBuilder sb = new StringBuilder();

        sb.append("query {\n  ");
        sb.append(root);

        if (!args.isEmpty()) {
            sb.append("(");
            sb.append(args.entrySet().stream()
                .map(e -> e.getKey() + ": " + formatValue(e.getValue()))
                .collect(Collectors.joining(", ")));
            sb.append(")");
        }

        sb.append(" ");
        sb.append(selection.render(2));
        sb.append("\n}");

        return sb.toString();
    }

    private String formatValue(Object value) {
        if (value instanceof String) {
            return "\"" + value + "\"";
        }
        return String.valueOf(value);
    }
}

public class Selector {

    public <T> QueryBuilder<T> query(Class<T> rootClass) {
        String rootName = decapitalize(rootClass.getSimpleName());
        return new QueryBuilder<>(rootName);
    }

    private String decapitalize(String s) {
        return Character.toLowerCase(s.charAt(0)) + s.substring(1);
    }
}

public class QueryBuilder<T> {

    private final String root;
    private final Map<String, Object> args = new LinkedHashMap<>();
    private SelectionNode selection;

    public QueryBuilder(String root) {
        this.root = root;
    }

    public QueryBuilder<T> args(Consumer<ArgsBuilder<T>> consumer) {
        ArgsBuilder<T> builder = new ArgsBuilder<>(args);
        consumer.accept(builder);
        return this;
    }

    public QueryBuilder<T> select(Consumer<SelectionBuilder<T>> consumer) {
        SelectionBuilder<T> builder = new SelectionBuilder<>();
        consumer.accept(builder);
        this.selection = builder.build();
        return this;
    }

    public GraphQLQuery build() {
        return new GraphQLQuery(root, selection, args);
    }
}

public class ArgsBuilder<T> {

    private final Map<String, Object> args;

    public ArgsBuilder(Map<String, Object> args) {
        this.args = args;
    }

    public <V> ArgsBuilder<T> arg(Function<T, V> getter, V value) {
        args.put(resolveName(getter), value);
        return this;
    }

    public <V> ArgsBuilder<T> arg(Function<T, V> getter, Consumer<ArgsBuilder<V>> nested) {
        Map<String, Object> nestedMap = new LinkedHashMap<>();
        nested.accept(new ArgsBuilder<>(nestedMap));
        args.put(resolveName(getter), nestedMap);
        return this;
    }

    private String resolveName(Function<?, ?> getter) {
        return LambdaUtils.resolveFieldName(getter);
    }
}

public class SelectionBuilder<T> {

    private final SelectionNode node = new SelectionNode();

    public <R> SelectionBuilder<T> field(Function<T, R> getter, Consumer<SelectionBuilder<R>> nested) {
        String name = LambdaUtils.resolveFieldName(getter);

        SelectionBuilder<R> child = new SelectionBuilder<>();
        nested.accept(child);

        node.children.put(name, child.build());
        return this;
    }

    public <R> SelectionBuilder<T> field(Function<T, R> getter) {
        String name = LambdaUtils.resolveFieldName(getter);
        node.children.put(name, new SelectionNode());
        return this;
    }

    @SafeVarargs
    public final <R> SelectionBuilder<T> fields(Function<T, R>... getters) {
        for (Function<T, R> g : getters) {
            field(g);
        }
        return this;
    }

    public <R> SelectionBuilder<T> allFields(Function<T, R> getter, Consumer<AllFieldsBuilder<R>> nested) {
        String name = LambdaUtils.resolveFieldName(getter);

        AllFieldsBuilder<R> builder = new AllFieldsBuilder<>();
        nested.accept(builder);

        node.children.put(name, builder.build());
        return this;
    }

    public <R> SelectionBuilder<T> allFields(Function<T, R> getter) {
        String name = LambdaUtils.resolveFieldName(getter);
        node.children.put(name, SelectionNode.all());
        return this;
    }

    public SelectionNode build() {
        return node;
    }
}

public class AllFieldsBuilder<T> {

    private final Set<String> excluded = new LinkedHashSet<>();

    @SafeVarargs
    public final <R> AllFieldsBuilder<T> except(Function<T, R>... getters) {
        for (Function<T, R> g : getters) {
            excluded.add(LambdaUtils.resolveFieldName(g));
        }
        return this;
    }

    public SelectionNode build() {
        return SelectionNode.allExcept(excluded);
    }
}

public class SelectionNode {

    Map<String, SelectionNode> children = new LinkedHashMap<>();
    boolean all;
    Set<String> excluded = new HashSet<>();

    public static SelectionNode all() {
        SelectionNode n = new SelectionNode();
        n.all = true;
        return n;
    }

    public static SelectionNode allExcept(Set<String> excluded) {
        SelectionNode n = new SelectionNode();
        n.all = true;
        n.excluded = excluded;
        return n;
    }

    public String render(int indent) {
        StringBuilder sb = new StringBuilder();
        String pad = " ".repeat(indent);

        sb.append("{\n");

        if (all) {
            sb.append(pad).append("  ...ALL_FIELDS");
            if (!excluded.isEmpty()) {
                sb.append(" EXCEPT ").append(excluded);
            }
            sb.append("\n");
        } else {
            for (Map.Entry<String, SelectionNode> e : children.entrySet()) {
                sb.append(pad).append("  ").append(e.getKey());
                if (!e.getValue().children.isEmpty() || e.getValue().all) {
                    sb.append(" ").append(e.getValue().render(indent + 2));
                }
                sb.append("\n");
            }
        }

        sb.append(pad).append("}");
        return sb.toString();
    }
}

public class LambdaUtils {

    public static String resolveFieldName(Function<?, ?> fn) {
        try {
            Method m = fn.getClass().getDeclaredMethod("writeReplace");
            m.setAccessible(true);
            SerializedLambda lambda = (SerializedLambda) m.invoke(fn);

            String method = lambda.getImplMethodName();

            if (method.startsWith("get")) {
                return decap(method.substring(3));
            } else if (method.startsWith("is")) {
                return decap(method.substring(2));
            }

            return method;
        } catch (Exception e) {
            throw new RuntimeException(e);
        }
    }

    private static String decap(String s) {
        return Character.toLowerCase(s.charAt(0)) + s.substring(1);
    }
}

