Selector selector = new Selector();
GraphQLQuery query = selector.query(TrackingInfo.class)

    // args (builder tipado)
    .args(a -> a
        .arg(TrackingInfo::getDeviceId, "device-123")

        .arg(TrackingInfo::getCoordinates, c -> c
            .arg(Coordinates::getLatitude, -23.5)
            .arg(Coordinates::getLongitude, -46.6)
        )
    )

    // select (modo positivo)
    .select(t -> t

        // allFields puro
        .allFields(TrackingInfo::getMetadata)

        // allFields com except
        .allFields(TrackingInfo::getCoordinates, c -> c
            .except(
                Coordinates::getAltitude,
                Coordinates::getTimestamp
            )
        )

        // field (com nested)
        .field(TrackingInfo::getMovement, m -> m
            .field(Movement::getSpeed)
            .field(Movement::getHeading)
        )

        // fields (leaf nodes)
        .field(TrackingInfo::getBattery, b -> b
            .fields(
                BatteryStatus::getLevel,
                BatteryStatus::isCharging
            )
        )

        // lista + nested + fields
        .field(TrackingInfo::getEvents, e -> e
            .fields(
                TrackedEvent::getType,
                TrackedEvent::getSeverity
            )
        )

        // mistura de field + fields
        .field(TrackingInfo::getConnectivity, c -> c
            .fields(
                Connectivity::getNetworkType,
                Connectivity::getSignalStrength
            )
        )

        // outro allFields
        .allFields(TrackingInfo::getGeoSpatial)

        // field simples
        .field(TrackingInfo::getContext, ctx -> ctx
            .fields(
                UserContext::isHome,
                UserContext::isWork
            )
        )
    );