7) ArchUnit:                                                |
------------------------------------------------------------
Como garantir que todo esse rigor não se perca com o tempo ou com a entrada de novos desenvolvedores? É aqui que entra o ArchUnit. Uma biblioteca Java para
verificar a arquitetura do seu código através de testes unitários comuns. Ex.:

  @AnalyzeClasses(packages = "com.company.subseller")
  public class CleanArchitectureTest {

    // valida @Service e @Transactional do service
    @ArchTest
    public static final ArchRule dominio_deve_ser_independente_de_framework = noClasses()
        .that().resideInAPackage("..domain.service..")
        .should().beAnnotatedWith("org.springframework.stereotype.Service")
        .orShould().beAnnotatedWith("org.springframework.transaction.annotation.Transactional")
        .because("O domínio não deve conhecer o framework. @Service e @Transactional " +
             "devem ser configurados na camada de infraestrutura (provider) " +
             "através de Beans de configuração ou OutAdapters.");

    // controller nao chama provider
    @ArchTest
    public static final ArchRule api_nao_deve_acessar_infraestrutura = noClasses()
        .that().resideInAPackage("..api..")
        .should().dependOnClassesThat()
        .resideInAPackage("..provider..")
        .because("A API deve interagir apenas com o Domínio. Detalhes de infraestrutura devem estar ocultos.");

    // implementação de logger no dominio
    @ArchTest
    public static final ArchRule dominio_nao_deve_chamar_logger_diretamente = noClasses()
        .that().resideInAPackage("..domain..")
        .should().dependOnClassesThat()
        .resideInAnyPackage("org.slf4j..", "org.apache.logging..", "java.util.logging..")
        .because("Logs são Cross-Cutting Concerns. O domínio deve emitir Eventos, não gerenciar Logs.");

    // valida estrutura de packages
    @ArchTest
    public static final ArchRule camadas_devem_respeitar_hierarquia = layeredArchitecture()
        .consideringAllDependencies()
        .layer("API").definedBy("..api..")
        .layer("Domain").definedBy("..domain..")
        .layer("Provider").definedBy("..provider..")
        .whereLayer("API").mayNotBeAccessedByAnyLayer()
        .whereLayer("Domain").mayOnlyBeAccessedByLayers("API", "Provider")
        .whereLayer("Provider").mayNotBeAccessedByAnyLayer();
  }

